# OpenDMD Connect, spike S0: the TLS client probe's sdkconfig (the
# `connect-probe` feature, src/connect_probe.rs). The Makefile layers this
# on, with the record sizes, whenever the feature is on (FW_FEATURES or
# FW_RELEASE_FEATURES), and never otherwise: every other build keeps the
# TLS section of sdkconfig.defaults exactly (WPA-Enterprise only).
#
# Dynamic buffers: each TLS record buffer is taken for that record's size
# when it arrives and given back once read, and the key and CA data go
# after the handshake. TLS 1.3 cannot be had with them on IDF 5.3, so the
# probe speaks TLS 1.2.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# The asymmetric record sizes (the Makefile adds IN and OUT:
# CONNECT_TLS_IN, default 4096, CONNECT_TLS_OUT, default 2048). With
# dynamic buffers they are caps, not allocations: a record over IN ends
# the session.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
# The peer's chain is not kept once checked (~4 KB of heap a session).
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# RFC 5077 tickets: a reconnect skips the certificate and the key exchange.
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y
# The pinned roots stay in flash: mbedTLS asks for the one it needs
# (connect_probe::ca_cb) instead of holding a parsed list.
CONFIG_MBEDTLS_X509_TRUSTED_CERT_CALLBACK=y
# Certificate dates are checked (against SNTP's clock, or the build date
# until there is one: connect_probe's verify callback).
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# The session's socket (stream.rs asserts the sum).
CONFIG_LWIP_MAX_SOCKETS=15
