# --- Flash -------------------------------------------------------------
# The DevKit V1 boards on this project are 4 MB (verified with esptool).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table v2 — otadata, the firmware in `factory`, the updater in
# `ota_0`, and the `www` data partition (the web app's pack), 4 MB; see
# partitions.csv and docs/ota.md. NOTE: ESP-IDF's cmake resolves this path
# relative to its own CMakeLists inside the esp-idf-sys build dir, not the
# crate root, so the Makefile overrides it with an absolute path via
# ESP_IDF_SDKCONFIG_DEFAULTS. See the root CLAUDE.md "Build quirk".
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- FATFS -------------------------------------------------------------
# Long filenames are not optional: every path on a DMDoS card is long and has
# spaces (`/gifs/NEW 2021/...`). Without these two lines every open() fails.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# FatFs's largest sector size is IDF's wear-levelling sector size (ffconf.h:
# FF_MAX_SS = MAX(512, CONFIG_WL_SECTOR_SIZE)), and every FIL and the volume
# window are FF_MAX_SS bytes. The default 4096 is for FAT on flash, which this
# firmware does not have; with it each FIL is 4,136 B and the VFS preallocates
# SD_MAX_FILES of them at mount. 512 (the SD card's sector) frees ~30 KB of
# heap (opendmd-notes docs/research/fat-index.md).
CONFIG_WL_SECTOR_SIZE_512=y

# --- lwip on CPU0 --------------------------------------------------------
# lwip's tcpip task has no core affinity by default (priority 18), so the
# copy of every send buffer into its pbufs could run on CPU1, the display
# core. Serving the web app from the memory-mapped www pack made that
# measurable: the copy pulled the pack through CPU1's flash cache and evicted
# the display loop's code (+66/+80 deadline misses per 90 s at ~450 KB/s,
# against +5 idle). The firmware stages each slice in RAM on CPU0 first
# (www.rs), which halves it; pinning the task to CPU0 keeps every byte of
# network work off the display core. The WiFi task is already pinned to
# core 0 (CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0, the default).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# --- Tasks -------------------------------------------------------------
# Main task on CPU1, same as stripe-dashboard: keeps the render/blit loop off
# the core that services system (and, later, WiFi) interrupts.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# GIF decoding plus the RGB888 staging buffer wants more than the 3.5 KB default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- Radio and network -------------------------------------------------
# WiFi is on from phase 3a. Copied from ~/projects/stripe-dashboard except for
# the TLS section: this firmware speaks plain HTTP on the LAN only, so there
# is no mbedtls certificate bundle to carry, and no TLS at all (below).
CONFIG_ESP_WIFI_ENABLED=y

# The radio's memory is on a strict diet, and these numbers are not cosmetic.
# Post-panel there is ~162 KB of heap; the manifest index takes 40 KB and a
# playing GIF another ~54 KB (see "GIF heap budget" in the root CLAUDE.md), so
# everything with a socket in it has to fit in what is left. Defaults would
# cost ~50 KB; this set costs about half that.
#
# The expensive one is block-ack reordering: AMPDU keeps per-session reorder
# buffers and is worth roughly 15-20 KB on its own. Turning it off caps
# throughput at a few Mbit/s, which is irrelevant here — the files are 100 KB
# GIFs over a LAN and the bottleneck is the SD card's SPI bus, not the air.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
# Received frames lwIP holds (each one of these until the socket is read;
# see "The receive side" below). A dynamic buffer is allocated per frame, the
# frame's size, so the count costs nothing until frames are held. Six was
# not enough beside an upload: the one being received keeps its window full
# while the card writes, ~5760 B in four to six frames (the client sends a
# full segment and a partial one per 2 KB read), which left the rest of the
# network one buffer or none. A new connection's SYN, a status request, the
# ACKs of a reply in flight, and a refused upload's first frames all met a
# driver dropping everything (a test board under simultaneous uploads: 13 of
# 214 status polls took 1 or 2 s to connect, one reply stalled 10 s, two
# uploads starved into a reset; net-stall, 2026-11-05). Eight leaves two or
# more besides; the two extra cost up to ~3.3 KB of heap, only while held.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# Credentials live in our own NVS namespace and the driver is put in
# WIFI_STORAGE_RAM anyway, so the driver's NVS support is dead weight.
CONFIG_ESP_WIFI_NVS_ENABLED=n

# lwip. One httpd task serves four sockets (config::HTTP_MAX_SOCKETS) and
# needs three more of its own, plus one for the captive-portal DNS server (or
# the RePlayOS client), plus three for uploads the stream task has taken out
# of httpd (room for the stream queue's three: stream.rs asserts the sum); and
# nothing here speaks IPv6, so the default windows and mailbox depths are
# oversized. A socket is a few dozen bytes of table until it is used.
# 14 = HTTP_MAX_SOCKETS (7, six for a browser's keep-alive connections plus
# one evictable) + 3 (listening, control, spare) + 1 (DNS) + 3 (uploads).
CONFIG_LWIP_MAX_SOCKETS=14
CONFIG_LWIP_IPV6=n
# The receive side is bounded by the WiFi driver, not the heap. Without
# LWIP_L2_TO_L3_COPY every received frame stays in one of the driver's
# DYNAMIC_RX_BUFFER_NUM (8; 6 until net-stall) buffers for as long as lwIP
# holds its pbuf, and with all of them held the driver drops every frame:
# TCP, ARP and ping alike
# (net-wedge, 2026-11-03; measured with the emulator's netdiag walk of
# lwIP's pcbs and sockets, `emu-census` builds).
#
# Out-of-order segments expire one RTO after the last frame received. lwIP
# keeps up to 4 segments per connection that arrive after a lost one
# (TCP_QUEUE_OOSEQ), also on connections already closed, and dropped them
# only after TCP_OOSEQ_TIMEOUT (6) RTOs without a frame received. Two 408'd
# uploads left in FIN_WAIT_1 (no socket) held 4 + 2 such segments, all six
# buffers (then), so the ACK of their FIN could never come in; each FIN
# retransmission doubled the RTO, and with it the expiry, which the time
# since the last frame never caught up with: nothing received again (the
# test board's wedge: no HTTP, ping or ARP, for good). With a factor of 1 it
# always does: between two retransmissions the silence grows past the RTO
# (tcp_slowtmr backs the RTO off first, then compares), so any held
# segments go within about one RTO, socket or not (1.5 s at the first), and
# a connection starved of buffers by them gets its retransmission in. Off
# altogether (TCP_QUEUE_OOSEQ=n) was tried: every loss then cost the rest of
# the window, and a single 570 KB upload ran into the 120 s cap in the
# emulator; so was two per connection (TCP_OOSEQ_MAX_PBUFS=2): the firmware
# bundle's upload slowed by a quarter there and ran into it too. What a
# socket not read yet holds is kept down by the stream task: one upload at
# a time, taken only when nothing else is, a second one refused at once
# (stream.rs).
#
# The windows: 5760 (four MSS) both ways, what every build so far really
# had. The 1440 asked for here before is under Kconfig's minimum (2440), so
# the build silently took the default (a test board's boot log: `tcp rx win:
# 5760`), and all the throughput and heap figures in these notes were
# measured at 5760. A 2880 receive window was tried with the fix: uploads
# went ~3.5x slower in the emulator (300 KB in 52 s against 15 s) and the
# 2.2 MB firmware bundle ran into the 120 s body cap, while what it bought
# (two buffers held by a waiting upload, not four) the one-upload rule gives
# already. A window caps bytes, not frames: small segments held five
# buffers for 2.6 KB.
CONFIG_LWIP_TCP_OOSEQ_TIMEOUT=1
#
# The first retransmission: 1 s (RFC 6298's initial RTO), not ESP-IDF's
# 1500 ms. A connection's segments sent before any RTT sample (its reply,
# every time: a status read or a 503 is one exchange) go again after 1, 3
# and 7 s here, against 1.5, 4.5 and 10.5 s (lwIP doubles from the start
# value). A test board under five 300 KB uploads at once (net-wedge2): every
# refusal and the winning upload's reply came 10.5-11 s late, the third send
# of the reply, and a status read gave up at 5 s, while the heap stood at 8
# KB and the WiFi driver, which allocates its frame buffers from it, could
# not take them. The heap is kept off that floor now (http.rs, netstat.rs);
# this shortens what a lost reply costs when it happens anyway. Once a
# connection has an RTT sample (a LAN's few ms) the timer is its own.
CONFIG_LWIP_TCP_RTO_TIME=1000
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

# No HTTPS, and TLS only for WPA-Enterprise. Nothing on the device speaks
# HTTPS: the one outbound request, Follow RePlayOS's poll, is plain HTTP on
# the LAN over a std TcpStream (opendmd_core::http_client, not
# esp_http_client), update checks are the browser's, and the device serves
# no HTTPS (opendmd-notes docs/research/https-serving.md). So esp_http_client is built
# without its HTTPS path and esp-tls is never linked. 802.1X/EAP
# (enterprise) WiFi is on (restore-cuts, 2026-11-06): PEAP and TTLS run
# their TLS through mbedtls's TLS client (ESP_WIFI_MBEDTLS_TLS_CLIENT, the
# default; wpa_supplicant's own internal TLS was measured 10 KB larger and
# has no ECDHE, GCM or ECDSA certificates), so mbedtls is client-only, with
# the parts EAP never uses off (renegotiation, ALPN, session tickets, DTLS,
# CRL/CSR parsing, PKCS#7, static-ECDH key exchanges). Only the curves
# WPA3-SAE/OWE need stay (P-256, P-384, P-521; a RADIUS server's ECDHE uses
# them too). Measured in opendmd-notes docs/research/size-budget.md 1.5 and 1.6; any
# future on-device HTTPS has to undo the HTTPS line and link esp-tls.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_SSL_ALPN=n
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=n
CONFIG_MBEDTLS_SSL_PROTO_DTLS=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_PKCS7_C=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n

# HTTP server. Desktop browsers send headers longer than the 512 B default,
# and the card's paths are long enough to need the bigger URI buffer
# (`/gifs/NEW 2021/...`, percent-encoded).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- HUB75 panel driver ------------------------------------------------
# The ESP32-HUB75-MatrixPanel-I2S-DMA component defaults to `y` here, which
# makes its CMakeLists REQUIRE the `arduino` and `Adafruit-GFX-Library`
# components and fail the configure step with "Missing component: arduino".
# We only ever call it through components/hub75_shim, so build it -DNO_GFX.
CONFIG_ESP32_HUB75_USE_GFX=n

# --- Logging -----------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The log ring's drain (src/logring.rs) is a periodic FreeRTOS timer: it runs
# on the timer service task, which is idle otherwise (every other timer here
# is an esp_timer) and had no core affinity. CPU0 keeps its UART writes off
# the display core, and the task already exists, so the drain costs no heap.
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y

# The display's wake (src/wake.rs) is an esp_timer dispatched from its ISR,
# not from the esp_timer task: the task runs on CPU0 at priority 22, behind
# the Wi-Fi task and anything else busy there, and a busy CPU0 woke the
# display late (a test board under /api/status polls: 484 late starts in 4,956
# raced frames, 2026-11-02). The ISR gives the display's semaphore.
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y

# 1 ms scheduler tick: the display loop sleeps for the remainder of each GIF frame
# delay, and 10 ms ticks rounded every sleep up, running content 5-10% slow.
CONFIG_FREERTOS_HZ=1000

# --- CPU and C optimisation --------------------------------------------
# 240 MHz: GIF decode is CPU-bound (3-11 ms a frame at 160 MHz); see "Frame
# time" in the root CLAUDE.md for the before/after probe numbers.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# IDF's C at -Os instead of the default -Og: the dev image had grown to ~99%
# of the OTA slot. Our hub75 shim pins itself to -O2 in its own CMakeLists, so
# the blit is unaffected, and pins esp_driver_spi back to -Og: at -Os the SD
# card timed out under concurrent reads (see "Frame time" in CLAUDE.md). Rust
# code is governed by Cargo's profiles, not this.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Console UART --------------------------------------------------------
# 921600 baud (IDF default 115200). With the log ring (src/logring.rs) the
# baud no longer costs the display anything; this is the wire's speed only,
# and every serial tool must match it (tools/serial-capture.py, fw-monitor).
# Byte-clean on a test panel: 0 malformed lines in 60 min of play (CLAUDE.md,
# "Gotchas").
# The baud is only settable on a "custom" UART console: UART0 on GPIO1/3,
# the same port and pins as the default one.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# --- Brownout detector -------------------------------------------------
# The panels and the ESP32 share one 5 V supply (the DevKit's LDO makes the
# 3.3 V from it). At brightness 192 on a full-white screen the chip froze
# with no reset (2026-09-29, 3 of 3; config::BRIGHTNESS_SAFE_MAX): the rail
# sagged below what the flash/CPU tolerate (the WROOM module is specified
# for 3.0-3.6 V, typical SPI NOR flash for >= 2.7 V) but not below the IDF's
# default detector level, 0 (2.43 V +/- 0.05). The ESP32 levels (IDF v5.3,
# esp_system/port/soc/esp32/Kconfig.system; estimates, per chip variation):
#   0 2.43 V, 1 2.48 V, 2 2.58 V, 3 2.62 V, 4 2.67 V, 5 2.70 V, 6 2.77 V,
#   7 2.80 V (each +/- 0.05).
# Level 7 is the only one whose whole tolerance band (2.75-2.85 V) sits
# above the flash's 2.7 V minimum, so a sag that would corrupt flash reads
# trips the detector first and ends in a clean `brownout` reset, which safe
# start (main.rs `SafeStart`) then recovers from. Still ~0.45 V below the
# 3.3 V rail, and checked on a test panel for spurious resets (normal play at
# brightness 40, reboots). On this IDF the ESP32's detector works through
# its interrupt (ESP_SYSTEM_BROWNOUT_INTR, selected by ESP32_REV_MIN_0 and
# SPI_FLASH_BROWNOUT_RESET): the ISR stalls the other core, resets the flash
# chip and does a software system reset. Deleting the generated sdkconfig
# (target/.../esp-idf-sys-*/out/sdkconfig) is needed for this to take effect.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
