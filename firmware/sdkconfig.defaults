# --- Flash -------------------------------------------------------------
# The DevKit V1 boards on this project are 4 MB (verified with esptool).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table — one factory app and the `www` data partition (the web
# app's pack), 4 MB; no OTA. NOTE: ESP-IDF's cmake resolves this path
# relative to its own CMakeLists inside the esp-idf-sys build dir, not the
# crate root, so the Makefile overrides it with an absolute path via
# ESP_IDF_SDKCONFIG_DEFAULTS. See the root CLAUDE.md "Build quirk".
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- FATFS -------------------------------------------------------------
# Long filenames are not optional: every path on a DMDoS card is long and has
# spaces (`/gifs/NEW 2021/...`). Without these two lines every open() fails.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# --- lwip on CPU0 --------------------------------------------------------
# lwip's tcpip task has no core affinity by default (priority 18), so the
# copy of every send buffer into its pbufs could run on CPU1, the display
# core. Serving the web app from the memory-mapped www pack made that
# measurable: the copy pulled the pack through CPU1's flash cache and evicted
# the display loop's code (+66/+80 deadline misses per 90 s at ~450 KB/s,
# against +5 idle). The firmware stages each slice in RAM on CPU0 first
# (www.rs), which halves it; pinning the task to CPU0 keeps every byte of
# network work off the display core. The WiFi task is already pinned to
# core 0 (CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0, the default).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# --- Tasks -------------------------------------------------------------
# Main task on CPU1, same as stripe-dashboard: keeps the render/blit loop off
# the core that services system (and, later, WiFi) interrupts.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# GIF decoding plus the RGB888 staging buffer wants more than the 3.5 KB default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- Radio and network -------------------------------------------------
# WiFi is on from phase 3a. Copied from ~/projects/stripe-dashboard except for
# the TLS section, which is deliberately absent: this firmware speaks plain
# HTTP on the LAN only, so there is no mbedtls certificate bundle to carry
# (~50 KB of flash and a chunk of heap per session that we do not spend).
CONFIG_ESP_WIFI_ENABLED=y

# The radio's memory is on a strict diet, and these numbers are not cosmetic.
# Post-panel there is ~162 KB of heap; the manifest index takes 40 KB and a
# playing GIF another ~54 KB (see "GIF heap budget" in the root CLAUDE.md), so
# everything with a socket in it has to fit in what is left. Defaults would
# cost ~50 KB; this set costs about half that.
#
# The expensive one is block-ack reordering: AMPDU keeps per-session reorder
# buffers and is worth roughly 15-20 KB on its own. Turning it off caps
# throughput at a few Mbit/s, which is irrelevant here — the files are 100 KB
# GIFs over a LAN and the bottleneck is the SD card's SPI bus, not the air.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# Credentials live in our own NVS namespace and the driver is put in
# WIFI_STORAGE_RAM anyway, so the driver's NVS support is dead weight.
CONFIG_ESP_WIFI_NVS_ENABLED=n

# lwip. One httpd task serves four sockets (config::HTTP_MAX_SOCKETS) and
# needs three more of its own, plus one for the captive-portal DNS server (or
# the RePlayOS client), plus three for uploads the stream task has taken out
# of httpd (one receiving, two queued: stream.rs asserts the sum); and
# nothing here speaks IPv6, so the default windows and mailbox depths are
# oversized. A socket is a few dozen bytes of table until it is used.
# 14 = HTTP_MAX_SOCKETS (7, six for a browser's keep-alive connections plus
# one evictable) + 3 (listening, control, spare) + 1 (DNS) + 3 (uploads).
CONFIG_LWIP_MAX_SOCKETS=14
CONFIG_LWIP_IPV6=n
# One MSS each. Two MSS was measurably faster and measurably closer to the
# out-of-memory line; with a ~20 KB floor the margin is worth more than the
# throughput, which is still ~200 KB/s off the card.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=1440
CONFIG_LWIP_TCP_WND_DEFAULT=1440
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

# HTTP server. Desktop browsers send headers longer than the 512 B default,
# and the card's paths are long enough to need the bigger URI buffer
# (`/gifs/NEW 2021/...`, percent-encoded).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- HUB75 panel driver ------------------------------------------------
# The ESP32-HUB75-MatrixPanel-I2S-DMA component defaults to `y` here, which
# makes its CMakeLists REQUIRE the `arduino` and `Adafruit-GFX-Library`
# components and fail the configure step with "Missing component: arduino".
# We only ever call it through components/hub75_shim, so build it -DNO_GFX.
CONFIG_ESP32_HUB75_USE_GFX=n

# --- Logging -----------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The log ring's drain (src/logring.rs) is a periodic FreeRTOS timer: it runs
# on the timer service task, which is idle otherwise (every other timer here
# is an esp_timer) and had no core affinity. CPU0 keeps its UART writes off
# the display core, and the task already exists, so the drain costs no heap.
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y

# 1 ms scheduler tick: the display loop sleeps for the remainder of each GIF frame
# delay, and 10 ms ticks rounded every sleep up, running content 5-10% slow.
CONFIG_FREERTOS_HZ=1000

# --- CPU and C optimisation --------------------------------------------
# 240 MHz: GIF decode is CPU-bound (3-11 ms a frame at 160 MHz); see "Frame
# time" in the root CLAUDE.md for the before/after probe numbers.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# IDF's C at -Os instead of the default -Og: the dev image had grown to ~99%
# of the OTA slot. Our hub75 shim pins itself to -O2 in its own CMakeLists, so
# the blit is unaffected, and pins esp_driver_spi back to -Og: at -Os the SD
# card timed out under concurrent reads (see "Frame time" in CLAUDE.md). Rust
# code is governed by Cargo's profiles, not this.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Console UART --------------------------------------------------------
# 921600 baud (IDF default 115200). With the log ring (src/logring.rs) the
# baud no longer costs the display anything; this is the wire's speed only,
# and every serial tool must match it (tools/serial-capture.py, fw-monitor).
# Byte-clean on the rig: 0 malformed lines in 60 min of play (CLAUDE.md,
# "Gotchas").
# The baud is only settable on a "custom" UART console: UART0 on GPIO1/3,
# the same port and pins as the default one.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# --- Brownout detector -------------------------------------------------
# The panels and the ESP32 share one 5 V supply (the DevKit's LDO makes the
# 3.3 V from it). At brightness 192 on a full-white screen the chip froze
# with no reset (2026-09-29, 3 of 3; config::BRIGHTNESS_SAFE_MAX): the rail
# sagged below what the flash/CPU tolerate (the WROOM module is specified
# for 3.0-3.6 V, typical SPI NOR flash for >= 2.7 V) but not below the IDF's
# default detector level, 0 (2.43 V +/- 0.05). The ESP32 levels (IDF v5.3,
# esp_system/port/soc/esp32/Kconfig.system; estimates, per chip variation):
#   0 2.43 V, 1 2.48 V, 2 2.58 V, 3 2.62 V, 4 2.67 V, 5 2.70 V, 6 2.77 V,
#   7 2.80 V (each +/- 0.05).
# Level 7 is the only one whose whole tolerance band (2.75-2.85 V) sits
# above the flash's 2.7 V minimum, so a sag that would corrupt flash reads
# trips the detector first and ends in a clean `brownout` reset, which safe
# start (main.rs `SafeStart`) then recovers from. Still ~0.45 V below the
# 3.3 V rail, and checked on the rig for spurious resets (normal play at
# brightness 40, reboots). On this IDF the ESP32's detector works through
# its interrupt (ESP_SYSTEM_BROWNOUT_INTR, selected by ESP32_REV_MIN_0 and
# SPI_FLASH_BROWNOUT_RESET): the ISR stalls the other core, resets the flash
# chip and does a software system reset. Deleting the generated sdkconfig
# (target/.../esp-idf-sys-*/out/sdkconfig) is needed for this to take effect.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
