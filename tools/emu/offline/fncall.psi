name "Deep fncall"
-- user-function calls nested to the compiler's cap: the compile task's stack, measured (emu-offline)
fn f0(v) = v * 0.5
fn f1(v) = f0(v + 0.01)
fn f2(v) = f1(v + 0.01)
fn f3(v) = f2(v + 0.01)
fn f4(v) = f3(v + 0.01)
fn f5(v) = f4(v + 0.01)
fn f6(v) = f5(v + 0.01)
fn f7(v) = f6(v + 0.01)
fn f8(v) = f7(v + 0.01)
fn f9(v) = f8(v + 0.01)
fn f10(v) = f9(v + 0.01)
fn f11(v) = f10(v + 0.01)
fn f12(v) = f11(v + 0.01)
fn f13(v) = f12(v + 0.01)
fn f14(v) = f13(v + 0.01)
fn f15(v) = f14(v + 0.01)
fn f16(v) = f15(v + 0.01)
fn f17(v) = f16(v + 0.01)
fn f18(v) = f17(v + 0.01)
fn f19(v) = f18(v + 0.01)
fn f20(v) = f19(v + 0.01)
fn f21(v) = f20(v + 0.01)
fn f22(v) = f21(v + 0.01)
gray(f22(x))
