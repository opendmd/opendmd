{"type":"palette","id":"pl_c8d11cf210e6ec6d5be062834f9d7c2c","rev":1,"hash":"sha256-3863c713721146989db33debfa77d9ddfc018e7c1869786cb8c1839025935a3b","name":"Game Boy DMG","tags":["hardware","handheld","4-colour"],"note":"The four shades of the original Game Boy's greenish LCD, darkest first.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"The widely used emulator convention for the DMG's four shades. The real screen is a reflective LCD with no fixed RGB values; this is an approximation, not a measurement."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#0f380f","name":"Darkest"},{"k":2,"hex":"#306230","name":"Dark"},{"k":3,"hex":"#8bac0f","name":"Light"},{"k":4,"hex":"#9bbc0f","name":"Lightest"}]}},
{"type":"palette","id":"pl_fb7bbb6e6b7730367d3d899b520db55d","rev":1,"hash":"sha256-3e2b05ceaf8627da516832574a5578bb022960497f8786fa43c611691879d5ab","name":"Game Boy Pocket","tags":["hardware","handheld","4-colour"],"note":"The four shades of the Game Boy Pocket's grey LCD, darkest first.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"The Pocket's LCD is neutral grey; these are the four 2-bit shades spread evenly from black to white, the usual neutral rendering. An approximation, not a measurement."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Darkest"},{"k":2,"hex":"#555555","name":"Dark"},{"k":3,"hex":"#aaaaaa","name":"Light"},{"k":4,"hex":"#ffffff","name":"Lightest"}]}},
