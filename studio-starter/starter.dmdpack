{"type":"palette","id":"pl_77767e9860c31fb6c1b5b0e263801d2e","rev":1,"hash":"sha256-41a763db1be5151af34907b2ea093813e1a6d4f7e68e464dd7bc48922e87aed0","name":"MSX / TMS9918","tags":["hardware","computer","console","15-colour"],"note":"The fifteen colours of the TMS9918 video chip (MSX, ColecoVision, SG-1000, TI-99/4A). The chip's colour 0 is see-through, so the key here is the hardware colour number.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"Converted from the chip's datasheet luminance and colour-difference levels for a CRT (gamma 1.6), values as tabulated on Wikipedia's TMS9918 page."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#0aad1e","name":"Medium green"},{"k":3,"hex":"#34c84c","name":"Light green"},{"k":4,"hex":"#2b2de3","name":"Dark blue"},{"k":5,"hex":"#514bfb","name":"Light blue"},{"k":6,"hex":"#bd2925","name":"Dark red"},{"k":7,"hex":"#1ee2ef","name":"Cyan"},{"k":8,"hex":"#fb2c2b","name":"Medium red"},{"k":9,"hex":"#ff5f4c","name":"Light red"},{"k":10,"hex":"#bda22b","name":"Dark yellow"},{"k":11,"hex":"#d7b454","name":"Light yellow"},{"k":12,"hex":"#0a8c18","name":"Dark green"},{"k":13,"hex":"#af329a","name":"Magenta"},{"k":14,"hex":"#b2b2b2","name":"Grey"},{"k":15,"hex":"#ffffff","name":"White"}]}},
{"type":"palette","id":"pl_d028c8f81318416c81dc09b498c75aeb","rev":1,"hash":"sha256-4a15917df06331c7db014e84f61ea997d0be8da1230e13e90716c29cc79414c2","name":"ZX Spectrum","tags":["hardware","computer","15-colour"],"note":"The ZX Spectrum's eight colours at normal and bright intensity, in hardware order (bright black is the same black, so fifteen in all).","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"Each of R, G, B is fully off or on, with one brightness bit for all three. Normal intensity is drawn at 0xD7 (about 85 %), a common emulator convention; real machines differ by model."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#0000d7","name":"Blue"},{"k":3,"hex":"#d70000","name":"Red"},{"k":4,"hex":"#d700d7","name":"Magenta"},{"k":5,"hex":"#00d700","name":"Green"},{"k":6,"hex":"#00d7d7","name":"Cyan"},{"k":7,"hex":"#d7d700","name":"Yellow"},{"k":8,"hex":"#d7d7d7","name":"White"},{"k":9,"hex":"#0000ff","name":"Bright blue"},{"k":10,"hex":"#ff0000","name":"Bright red"},{"k":11,"hex":"#ff00ff","name":"Bright magenta"},{"k":12,"hex":"#00ff00","name":"Bright green"},{"k":13,"hex":"#00ffff","name":"Bright cyan"},{"k":14,"hex":"#ffff00","name":"Bright yellow"},{"k":15,"hex":"#ffffff","name":"Bright white"}]}},
