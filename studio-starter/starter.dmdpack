{"type":"palette","id":"pl_66b93e1a93c9b7b62dcd2d7c586ee022","rev":1,"hash":"sha256-adf5c1b4ce3a3d8e41e282701c78f08bb83f3ab61516f4fbf264cca331eeb4a0","name":"C64 (Colodore)","tags":["hardware","computer","16-colour"],"note":"The Commodore 64's sixteen colours in hardware order, from Pepto's later 'Colodore' model. Brighter and more saturated than the 2001 set, so it suits LEDs better.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"Pepto's Colodore model (pepto.de/projects/colorvic) at its default settings (brightness 50, contrast 100, saturation 50), values as listed by Lospec. Key = colour number + 1."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#ffffff","name":"White"},{"k":3,"hex":"#813338","name":"Red"},{"k":4,"hex":"#75cec8","name":"Cyan"},{"k":5,"hex":"#8e3c97","name":"Purple"},{"k":6,"hex":"#56ac4d","name":"Green"},{"k":7,"hex":"#2e2c9b","name":"Blue"},{"k":8,"hex":"#edf171","name":"Yellow"},{"k":9,"hex":"#8e5029","name":"Orange"},{"k":10,"hex":"#553800","name":"Brown"},{"k":11,"hex":"#c46c71","name":"Light red"},{"k":12,"hex":"#4a4a4a","name":"Dark grey"},{"k":13,"hex":"#7b7b7b","name":"Grey"},{"k":14,"hex":"#a9ff9f","name":"Light green"},{"k":15,"hex":"#706deb","name":"Light blue"},{"k":16,"hex":"#b2b2b2","name":"Light grey"}],"source":"Commodore 64"}},
{"type":"palette","id":"pl_27e62b6e3d718d5286dfeb7a9fb0af4d","rev":1,"hash":"sha256-1c8d4262ee2138bd77875b6c66b0ff7e7af7e76a0a41ead28b354c25f2b89c64","name":"C64 (Pepto)","tags":["hardware","computer","16-colour"],"note":"The Commodore 64's sixteen colours in hardware order, as calculated by Philip 'Pepto' Timmermann in 2001. Muted, like the real machine.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"Pepto's 2001 calculation from measured VIC-II luma and chroma (pepto.de/projects/colorvic/2001). Key = colour number + 1."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#ffffff","name":"White"},{"k":3,"hex":"#68372b","name":"Red"},{"k":4,"hex":"#70a4b2","name":"Cyan"},{"k":5,"hex":"#6f3d86","name":"Purple"},{"k":6,"hex":"#588d43","name":"Green"},{"k":7,"hex":"#352879","name":"Blue"},{"k":8,"hex":"#b8c76f","name":"Yellow"},{"k":9,"hex":"#6f4f25","name":"Orange"},{"k":10,"hex":"#433900","name":"Brown"},{"k":11,"hex":"#9a6759","name":"Light red"},{"k":12,"hex":"#444444","name":"Dark grey"},{"k":13,"hex":"#6c6c6c","name":"Grey"},{"k":14,"hex":"#9ad284","name":"Light green"},{"k":15,"hex":"#6c5eb5","name":"Light blue"},{"k":16,"hex":"#959595","name":"Light grey"}],"source":"Commodore 64"}},
{"type":"palette","id":"pl_af15be4d521f1877c0c3b58c956f7fe9","rev":1,"hash":"sha256-821adb3364e058dc5be0869d509e36690703c7b393d07b32c262705d0c4a15f4","name":"CGA / EGA 16","tags":["hardware","pc","16-colour"],"note":"The sixteen RGBI colours of the IBM CGA, also the EGA's default sixteen, in hardware order.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"IBM's RGBI scheme as tabulated on Wikipedia's Color Graphics Adapter page: two thirds per channel when on, plus one third with the intensity bit; the monitor reduces colour 6's green, giving brown. Wikipedia's Enhanced Graphics Adapter page lists the same sixteen as the EGA default. Key = colour number + 1."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#0000aa","name":"Blue"},{"k":3,"hex":"#00aa00","name":"Green"},{"k":4,"hex":"#00aaaa","name":"Cyan"},{"k":5,"hex":"#aa0000","name":"Red"},{"k":6,"hex":"#aa00aa","name":"Magenta"},{"k":7,"hex":"#aa5500","name":"Brown"},{"k":8,"hex":"#aaaaaa","name":"Light grey"},{"k":9,"hex":"#555555","name":"Dark grey"},{"k":10,"hex":"#5555ff","name":"Light blue"},{"k":11,"hex":"#55ff55","name":"Light green"},{"k":12,"hex":"#55ffff","name":"Light cyan"},{"k":13,"hex":"#ff5555","name":"Light red"},{"k":14,"hex":"#ff55ff","name":"Light magenta"},{"k":15,"hex":"#ffff55","name":"Yellow"},{"k":16,"hex":"#ffffff","name":"White"}],"source":"IBM CGA and EGA"}},
{"type":"palette","id":"pl_672a490e7cf9ec610201627560c4670c","rev":1,"hash":"sha256-e398b1bbf457eff0eb5561b39d80e2b3b31e0ad37578e2554b96a6d899eeeb5a","name":"CGA Mode 4, Palette 0","tags":["hardware","pc","4-colour"],"note":"CGA 320x200 graphics, palette 0 at high intensity: black, green, red, yellow.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"Colours 0, 10, 12 and 14 of the RGBI sixteen (Wikipedia, Color Graphics Adapter); the background (first) colour is selectable on the hardware."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#55ff55","name":"Light green"},{"k":3,"hex":"#ff5555","name":"Light red"},{"k":4,"hex":"#ffff55","name":"Yellow"}],"source":"IBM CGA"}},
