{"type":"palette","id":"pl_b879bc64d2114182907fdaa4e65c0924","rev":1,"hash":"sha256-85054ef29aa8d138773667cd9928ef84a2e53fb70a0b9796e77dde56d754a8b3","name":"Atari 2600 (NTSC)","tags":["hardware","console","128-colour"],"note":"The Atari 2600's NTSC colours: sixteen hues by eight brightness levels, in hardware order, each named by its colour register value.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"Our own model, not a measurement: hue 0 is grey; hues 1 to 15 step 26.2 degrees round the NTSC colour wheel starting at gold (165 degrees in the U/V plane), at fixed saturation, with eight evenly spaced brightness levels, converted from YUV to RGB. Real consoles vary with their colour trimmer."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"$00"},{"k":2,"hex":"#222222","name":"$02"},{"k":3,"hex":"#434343","name":"$04"},{"k":4,"hex":"#656565","name":"$06"},{"k":5,"hex":"#878787","name":"$08"},{"k":6,"hex":"#a8a8a8","name":"$0A"},{"k":7,"hex":"#cacaca","name":"$0C"},{"k":8,"hex":"#ececec","name":"$0E"},{"k":9,"hex":"#343100","name":"$10"},{"k":10,"hex":"#504d00","name":"$12"},{"k":11,"hex":"#6c6900","name":"$14"},{"k":12,"hex":"#88850a","name":"$16"},{"k":13,"hex":"#a4a126","name":"$18"},{"k":14,"hex":"#c1bd42","name":"$1A"},{"k":15,"hex":"#ddd95e","name":"$1C"},{"k":16,"hex":"#f9f57a","name":"$1E"},{"k":17,"hex":"#4e1f00","name":"$20"},{"k":18,"hex":"#6a3b00","name":"$22"},{"k":19,"hex":"#865706","name":"$24"},{"k":20,"hex":"#a27322","name":"$26"},{"k":21,"hex":"#be8f3e","name":"$28"},{"k":22,"hex":"#daab5a","name":"$2A"},{"k":23,"hex":"#f6c776","name":"$2C"},{"k":24,"hex":"#ffe392","name":"$2E"},{"k":25,"hex":"#5f0e00","name":"$30"},{"k":26,"hex":"#7b2a14","name":"$32"},{"k":27,"hex":"#974630","name":"$34"},{"k":28,"hex":"#b3624c","name":"$36"},{"k":29,"hex":"#cf7e68","name":"$38"},{"k":30,"hex":"#eb9a84","name":"$3A"},{"k":31,"hex":"#ffb6a0","na