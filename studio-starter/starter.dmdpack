{"type":"palette","id":"pl_77767e9860c31fb6c1b5b0e263801d2e","rev":1,"hash":"sha256-317b8bcf46d8c3fce430a49338cb65d8e428e242d9c71dad29a67a10d8c74be4","name":"MSX / TMS9918","tags":["hardware","computer","console","15-colour"],"note":"The fifteen colours of the TMS9918 video chip (MSX, ColecoVision, SG-1000, TI-99/4A). The chip's colour 0 is see-through, so the key here is the hardware colour number.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"Converted from the chip's datasheet luminance and colour-difference levels for a CRT (gamma 1.6), values as tabulated on Wikipedia's TMS9918 page."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#0aad1e","name":"Medium green"},{"k":3,"hex":"#34c84c","name":"Light green"},{"k":4,"hex":"#2b2de3","name":"Dark blue"},{"k":5,"hex":"#514bfb","name":"Light blue"},{"k":6,"hex":"#bd2925","name":"Dark red"},{"k":7,"hex":"#1ee2ef","name":"Cyan"},{"k":8,"hex":"#fb2c2b","name":"Medium red"},{"k":9,"hex":"#ff5f4c","name":"Light red"},{"k":10,"hex":"#bda22b","name":"Dark yellow"},{"k":11,"hex":"#d7b454","name":"Light yellow"},{"k":12,"hex":"#0a8c18","name":"Dark green"},{"k":13,"hex":"#af329a","name":"Magenta"},{"k":14,"hex":"#b2b2b2","name":"Grey"},{"k":15,"hex":"#ffffff","name":"White"}],"source":"TMS9918"}},
{"type":"palette","id":"pl_d028c8f81318416c81dc09b498c75aeb","rev":1,"hash":"sha256-36ec20b2199e0e1751d38d13de807ca02e183cb9f17ce6bb40a04718378a4079","name":"ZX Spectrum","tags":["hardware","computer","15-colour"],"note":"The ZX Spectrum's eight colours at normal and bright intensity, in hardware order (bright black is the same black, so fifteen in all).","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"One bit each for green, red and blue plus a brightness bit. Normal intensity at 0xD8 (85 % of full, the voltage ratio Wikipedia's ZX Spectrum graphic modes page gives), values as in Lospec's 'ZX Spectrum' palette (lospec.com/palette-list/zx-spectrum). Real machines differ by model; some emulators use 0xD7."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#0000d8","name":"Blue"},{"k":3,"hex":"#d80000","name":"Red"},{"k":4,"hex":"#d800d8","name":"Magenta"},{"k":5,"hex":"#00d800","name":"Green"},{"k":6,"hex":"#00d8d8","name":"Cyan"},{"k":7,"hex":"#d8d800","name":"Yellow"},{"k":8,"hex":"#d8d8d8","name":"White"},{"k":9,"hex":"#0000ff","name":"Bright blue"},{"k":10,"hex":"#ff0000","name":"Bright red"},{"k":11,"hex":"#ff00ff","name":"Bright magenta"},{"k":12,"hex":"#00ff00","name":"Bright green"},{"k":13,"hex":"#00ffff","name":"Bright cyan"},{"k":14,"hex":"#ffff00","name":"Bright yellow"},{"k":15,"hex":"#ffffff","name":"Bright white"}],"source":"ZX Spectrum"}},
