{"type":"palette","id":"pl_c8d11cf210e6ec6d5be062834f9d7c2c","rev":1,"hash":"sha256-d4e50129b423b5febdec5ac73166c02cc698731d102f77728b9b8d3d6b663d21","name":"Game Boy DMG","tags":["hardware","handheld","4-colour"],"note":"The four shades of the original Game Boy's greenish LCD, darkest first.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"The four greens most often published for the original Game Boy (for example designpieces.com/palette/game-boy-original-color-palette-hex-and-rgb). A convention, not a measurement: the real screen is a reflective LCD with no fixed RGB values."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#0f380f","name":"Darkest"},{"k":2,"hex":"#306230","name":"Dark"},{"k":3,"hex":"#8bac0f","name":"Light"},{"k":4,"hex":"#9bbc0f","name":"Lightest"}],"source":"Game Boy"}},
{"type":"palette","id":"pl_fb7bbb6e6b7730367d3d899b520db55d","rev":1,"hash":"sha256-2a023b1f2847a5f116957d1a613f2d3b9dba569f277f5d2c18004fc9234c76a0","name":"Game Boy Pocket","tags":["hardware","handheld","4-colour"],"note":"The four shades of the Game Boy Pocket's grey LCD, darkest first.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"Our own rendering, with no published source for the values: the Pocket's LCD shows true grey rather than green (Wikipedia, List of video game console palettes), so these are its four 2-bit shades spread evenly from black to white."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Darkest"},{"k":2,"hex":"#555555","name":"Dark"},{"k":3,"hex":"#aaaaaa","name":"Light"},{"k":4,"hex":"#ffffff","name":"Lightest"}],"source":"Game Boy Pocket"}},
{"type":"palette","id":"pl_e46d7fb9c6b72c4954e0250d2ab58158","rev":1,"hash":"sha256-c13278e24421f509e09dbf7545429591bf13c78c7ce36c664d9b38911a59b17f","name":"Neon Arcade","tags":["original","led","neon"],"note":"Our own: saturated sign-tube colours on black, spaced widely in hue so neighbours stay distinct on LEDs.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#ffffff","name":"White"},{"k":3,"hex":"#ff2079","name":"Hot pink"},{"k":4,"hex":"#e000ff","name":"Magenta"},{"k":5,"hex":"#7a2cff","name":"Violet"},{"k":6,"hex":"#1e50ff","name":"Electric blue"},{"k":7,"hex":"#00e5ff","name":"Cyan"},{"k":8,"hex":"#00ffa0","name":"Mint"},{"k":9,"hex":"#b4ff00","name":"Lime"},{"k":10,"hex":"#ffe600","name":"Yellow"},{"k":11,"hex":"#ff7a00","name":"Orange"},{"k":12,"hex":"#ff1030","name":"Red"}],"source":"OpenDMD"}},
{"type":"palette","id":"pl_6082754063f564e7746d7093325f3445","rev":1,"hash":"sha256-70a0afb4b9cf22da6217154ab9e258f45123ec9f87533d5dd39df4d11ca073ae","name":"NES (RGB PPU)","tags":["hardware","console","50-colour"],"note":"The NES colours as produced by the 2C03 RGB version of its picture chip (PlayChoice-10, Vs. System), duplicates removed: 50 distinct colours, each named by its first hardware index.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[{"external":false,"note":"The home console's 2C02 chip makes composite video and has no exact RGB values. The 2C03's are exact: three bits per channel, level * 255 / 7, from the NESdev wiki's PPU palettes table. More saturated than a TV picture."}],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#6d6d6d","name":"$00"},{"k":2,"hex":"#002492","name":"$01"},{"k":3,"hex":"#0000db","name":"$02"},{"k":4,"hex":"#6d49db","name":"$03"},{"k":5,"hex":"#92006d","name":"$04"},{"k":6,"hex":"#b6006d","name":"$05"},{"k":7,"hex":"#b62400","name":"$06"},{"k":8,"hex":"#924900","name":"$07"},{"k":9,"hex":"#6d4900","name":"$08"},{"k":10,"hex":"#244900","name":"$09"},{"k":11,"hex":"#006d24","name":"$0A"},{"k":12,"hex":"#009200","name":"$0B"},{"k":13,"hex":"#004949","name":"$0C"},{"k":14,"hex":"#000000","name":"$0D"},{"k":15,"hex":"#b6b6b6","name":"$10"},{"k":16,"hex":"#006ddb","name":"$11"},{"k":17,"hex":"#0049ff","name":"$12"},{"k":18,"hex":"#9200ff","name":"$13"},{"k":19,"hex":"#b600ff","name":"$14"},{"k":20,"hex":"#ff0092","name":"$15"},{"k":21,"hex":"#ff0000","name":"$16"},{"k":22,"hex":"#db6d00","name":"$17"},{"k":23,"hex":"#926d00","name":"$18"},{"k":24,"hex":"#249200","name":"$19"},{"k":25,"hex":"#00b66d","name":"$1B"},{"k":26,"hex":"#009292","name":"$1C"},{"k":27,"hex":"#ffffff","name":"$20"},{"k":28,"hex":"#6db6ff","name":"$21"},{"k":29,"hex":"#9292ff","name":"$22"},{"k":30,"hex":"#db6dff","name":"$23"},{"k":31,"hex":"#ff00ff","name":"$24"},{"k":32,"hex":"#ff6dff","name":"$25"},{"k":33,"hex":"#ff9200","name":"$26"},{"k":34,"hex":"#ffb600","name":"$27"},{"k":35,"hex":"#dbdb00","name":"$28"},{"k":36,"hex":"#6ddb00","name":"$29"},{"k":37,"hex":"#00ff00","name":"$2A"},{"k":38,"hex":"#49ffdb","name":"$2B"},{"k":39,"hex":"#00ffff","name":"$2C"},{"k":40,"hex":"#b6dbff","name":"$31"},{"k":41,"hex":"#dbb6ff","name":"$32"},{"k":42,"hex":"#ffb6ff","name":"$33"},{"k":43,"hex":"#ff92ff","name":"$34"},{"k":44,"hex":"#ffb6b6","name":"$35"},{"k":45,"hex":"#ffdb92","name":"$36"},{"k":46,"hex":"#ffff49","name":"$37"},{"k":47,"hex":"#ffff6d","name":"$38"},{"k":48,"hex":"#b6ff49","name":"$39"},{"k":49,"hex":"#92ff6d","name":"$3A"},{"k":50,"hex":"#92dbff","name":"$3C"}],"source":"NES (2C03)"}},
{"type":"palette","id":"pl_28f8829f6a2bab20f4763197e5098f6b","rev":1,"hash":"sha256-f063fa9d83215c2215910188518a1ed94abfc9ef91b3ff15355106664480aec1","name":"Panel 16","tags":["original","led","starter"],"note":"Our own general-purpose set for LED panels: fifteen colours plus see-through, every one bright enough to read on a HUB75 panel. The starter stamps and templates use it.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Black"},{"k":2,"hex":"#ffffff","name":"White"},{"k":3,"hex":"#a8b0c0","name":"Silver"},{"k":4,"hex":"#505868","name":"Steel"},{"k":5,"hex":"#ff2030","name":"Red"},{"k":6,"hex":"#ff8000","name":"Orange"},{"k":7,"hex":"#ffd800","name":"Yellow"},{"k":8,"hex":"#20e040","name":"Green"},{"k":9,"hex":"#008838","name":"Pine"},{"k":10,"hex":"#00d8ff","name":"Cyan"},{"k":11,"hex":"#2060ff","name":"Blue"},{"k":12,"hex":"#102080","name":"Navy"},{"k":13,"hex":"#ff30c0","name":"Magenta"},{"k":14,"hex":"#8030ff","name":"Violet"},{"k":15,"hex":"#a04810","name":"Rust"}],"source":"OpenDMD"}},
{"type":"palette","id":"pl_49cb74bfa8d36c921016e6906f8a2284","rev":1,"hash":"sha256-c8e127778d5af3f982144744a7ce708a0d665427bdd1c32654bbbe0a19b9ed7b","name":"Phosphor Amber","tags":["original","led","crt","mono"],"note":"Our own: a six-step amber monochrome ramp in the manner of an amber CRT, with wide steps so the dark end survives a panel's low-brightness crush.","author":{"name":"OpenDMD","account":null},"licence":"CC0-1.0","from":[],"created":"2026-11-11T00:00:00Z","modified":"2026-11-11T00:00:00Z","body":{"colours":[{"k":1,"hex":"#000000","name":"Off"},{"k":2,"hex":"#4a2400","name":"Ember"},{"k":3,"hex":"#8f4a00","name":"Dim"},{"k":4,"hex":"#d07800","name":"Mid"},{"k":5,"hex":"#ffb000","name":"Amber"},{"k":6,"hex":"#ffe090","name":"Hot"}],"source":"OpenDMD"}},
