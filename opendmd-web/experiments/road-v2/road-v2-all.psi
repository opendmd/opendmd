-- author: OpenDMD
-- licence: CC0-1.0
name "Endless road V2 (all, sketch)"
about "Desert, megacity, tunnel, forest: the whole cycle in one rough sketch"
loop forever
fps 50

-- `psi check` refuses this file: 405 steps (the cap is 256) and 168 values
-- (128). That is its finding; see docs/research/endless-road-v2.md §3, §9.
-- A ROUGH SKETCH for docs/research/endless-road-v2.md: every environment
-- and every transition in one program, drawn crudely, to see where four
-- environments land against the step and value caps and the frame
-- estimate. Not art. See the design doc for what each part should be.

-- One palette for the sketch (the real one wants day/night sets per
-- environment: see the doc's palette-tween proposal)
palette p = black #000, road #403, roadStripe #806, yellow #ec0, red #f00,
  verge #400, vergeStripe #800, neon #1ef, pink #f29, sun #f70, sunLow #f20,
  body #b00, lights #f50, star #fff, nightVerge #001, nightRoad #103,
  #126, #17f, #25f, #42f, #50f, #70e, #a0e, #d0d, horizon #f48,
  tower #1a0a2e, window #90e8ff, magenta #f0f, wall #443, lamp #ffb,
  canopy #052, trunk #531

table carSpan = 273, 242, 273, 211, 242, 118, 56, 69, 242, 663, 56, 69, 242, 663, 56, 56, 25
table carRow = 136, 120, 121, 104, 105, 88, 72, 74, 73, 74, 56, 58, 57, 58, 40, 24, 9
table peakMid = 56, -6, -62
table peakHalf = 9, 13, 8
table palmOut = 5, 16, -5, 8
table palmUp = 22, 17, 17, 27

-- ---- The clock of the cycle: 324 s, from somewhere else each play ----
-- Desert 0-75, into the city 75-105, city 105-180, the tunnel's mouth
-- 180-188, tunnel 188-213, out of it 213-219, forest 219-294, thinning
-- 294-324. (The doc jitters the boundaries per cycle by a hash.)
tc = (t + seed*324) % 324
pDC = smoothstep(75, 105, tc)
pCT = smoothstep(180, 188, tc)
pTF = smoothstep(213, 219, tc)
pFD = smoothstep(294, 324, tc)
inTunnel = tc >= 188 and tc < 213
mouth = (tc >= 180 and tc < 188) or (tc >= 213 and tc < 219)
exiting = tc >= 213
mouthP = exiting ? pTF : pCT
city = pDC*(tc < 188)                    -- how much city: towers grow with it
forest = pTF*(1 - pFD)*(tc >= 213)       -- how dense the forest is
desert = (tc < 105)*(1 - pDC) + (tc >= 294)*pFD
cityNear = smoothstep(.5, 1, city)       -- the near row of towers, late

-- ---- The road (V1's) ----
driven = t*.15 + seed*1000
heading = noise(driven, 0, 0)
height = noise(driven, 5, 0)
slope = (noise(driven + .01, 5, 0) - height) * 100
carLeft = (heading - noise(driven + .03, 0, 0))*80 - 50.99999
skyMid = 94 - heading*60

-- ---- Day and night (V1's), a day of 4 minutes against a cycle of 324 s ----
sunPhase = sin(t/240 + hash(seed, 7))
light = clamp(sunPhase*sunPhase*sunPhase*-3, -1, 1)
night = clamp(-light, 0, 1)
day = clamp(light, 0, 1)
sunY = 23.5 - clamp(light*-24, -2.5, 20)
sunRow = 31 - sunY
sunR = 8 - day*3
skyStep = .5 - (night + day)/3
skyBase = 24.3 - 7*night - 4*day - skyStep*-19
neon = night > .5
palmInk = neon*p.pink
roadInk = neon ? p.nightRoad : p.road
kerbInk = (neon or city > .5) ? p.neon : p.yellow
vergeInk = neon ? p.nightVerge : p.verge
bodyInk = city > .5 ? p.magenta : p.body   -- the car takes the city's light
beamShift = neon*(p.nightRoad - p.road)

-- ---- The city's towers (Neon city's, scaled by `city`) ----
nearShift = heading*-90
towerGrow = city*13
twinkle = floor((t*3) % 997)*(city < .6)

-- ---- The tunnel's mouth (a box growing from the horizon) ----
mouthW = 6 + mouthP*mouthP*140
mouthTop = 19.5 + mouthP*mouthP*13
mouthBot = 19.5 - mouthP*mouthP*20

draw {
  -- The hills (desert only)
  for k < 3 {
    for j < 7 {
      hillHalf = peakHalf[k] - j*1.9
      hillX = skyMid - peakMid[k]
      line(hillX - hillHalf, 12 - j, hillX + hillHalf, 12 - j, (hillHalf >= 0 and desert > 0)*6/16)
    }
  }
  -- The sun (not in the tunnel, not through the forest's canopy)
  for k < 12 {
    e = 5 - k
    rowY = sunRow + e
    sunHalf = sqrt(max(sunR*sunR - e*e, 0))
    shown = rowY <= 11.5 and not inTunnel
    line(skyMid - sunHalf, rowY, skyMid + sunHalf, rowY, shown*5/16)
  }
  for k < 16 {
    dot(frac(k*.7549)*128, 10.5 + frac(k*.5698)*-11, (frac(k*.382) < night*1.4 - .4 and not inTunnel)*4/16)
  }
  -- Roadside objects: palms in the desert, trunks in the forest, lamp
  -- posts in the city; 6 places (3 a side), one every 14 stripes
  for k < 6 {
    place = t/1.4 - k*-.37
    along = frac(place)
    ahead = 14.7 - along*14
    size = 1.2/ahead
    baseY = 11.5 + 12.5*size
    sideX = cos(k/2)*size
    objX = 64 - (heading - noise(driven + ahead*.0075, 0, 0))*2000 - sideX*-47
    there = noise(place - along, k*5, 0)
    palm = desert > .3 and there > .45 and ahead < 11
    trunk = forest > 0 and there > 1 - forest and ahead < 11
    post = city > .5 and ahead < 11
    for j < 4 {
      frond = j > 0
      line(objX - frond*-5*sideX, baseY + frond*-22*size, objX + palmOut[j]*sideX, baseY - palmUp[j]*size, palm*7/16)
    }
    line(objX, baseY, objX, baseY - 30*size, trunk*11/16)
    line(objX, baseY, objX, baseY - 18*size, post*7/16)
    dot(objX, baseY - 18*size, post*12/16)
  }
  -- The city's neon: a lit edge on every other near tower
  for k < 17 {
    id = floor(nearShift/8) + k
    left = floor(id*8 + .9999 - nearShift)
    top = floor(hash(id%22, seed)*towerGrow + 19.9999)
    line(left + 6, 31 - (top), left + 6, 31 - (top > 31 ? 20 : top), (k%2 and cityNear > 0)*13/16)
  }
  -- The car, span by span
  for k < 17 {
    span = carSpan[k]/32
    rowInk = carRow[k]/16
    carY = floor(rowInk)
    line(floor(span) - carLeft, 31 - (carY), frac(span)*32 - carLeft, 31 - (carY), frac(rowInk))
  }
}

-- ---- Rows ----
yu = 31 - py
below = yu < 19
depth = below * .1125 / (19.5 - yu)
rowDriven = driven + depth
halfWidth = below*(50.7 - 2.6*(yu - clamp((noise(rowDriven, 5, 0) - height - depth*slope) * depth * 26667, -6, 2)))
stripe = (frac(39/max(halfWidth, 1.3) + t*10) < .5) * -p.step
offRoad = abs(px - (64 - (heading - noise(rowDriven, 0, 0))*2000))
beam = (abs(yu - 12.5) < 4) * halfWidth * .5
sky = floor(skyBase - yu*skyStep) * p.step
-- the city: towers above the horizon (the column run), lit windows
skyRow = below ? 99 : yu
windowRow = (yu - 20)/2 + yu%2*20
nearAt = px + nearShift
nearHeight = hash(floor(nearAt/8)%22, seed)*towerGrow
nearTop = (nearAt%8 < 7) * (19.5 + nearHeight)
farTop = max(19.5 + hash(seed, floor((px + nearShift*.44) / 6))*towerGrow*.7, nearTop)
windows = bit(42, nearAt%8)*floor(hash(floor(nearAt) + twinkle, seed)*127)
towers = (skyRow < farTop) + (skyRow < nearTop) + bit(windows, windowRow)
-- the tunnel: walls either side of the road, a ceiling over it, lamps
tunRow = below ? yu : 39 - yu
tunHalf = (50.7 - 2.6*tunRow)*1.5
inMouthRow = mouth * (yu > mouthBot) * (yu < mouthTop)
tunnelHere = inTunnel + inMouthRow*((offRoad < mouthW) != exiting)
wall = offRoad > tunHalf
lamp = (not below) * (offRoad < 2) * (stripe < 0)
tunIx = wall ? p.wall - stripe : (below ? -99 : (lamp ? p.lamp : p.black))
-- the forest: a canopy with a sliver of sky over the road
sliver = (yu - 19.5)*2.5/max(forest, .01)
canopy = forest > 0 and not below and offRoad > sliver
-- what each pixel shows
m = max((offRoad >= halfWidth) + (offRoad >= halfWidth*1.2), ink(16))
base = pick(m,
    roadInk - stripe, kerbInk - stripe, below ? vergeInk - stripe : sky,
    sky, p.star, yu - sunY < -.5 ? p.sunLow : (yu - sunY < 3.5 ? p.sun : p.yellow),
    p.black, palmInk, bodyInk, p.black, p.lights, p.trunk, p.lamp, p.neon)
cityIx = pick(towers, -99, p.tower, p.tower, p.window)
v1 = (m == 3 and cityIx > -1) ? cityIx : base
v2 = canopy ? p.canopy : v1
v3 = (tunnelHere > 0 and tunIx > -1) ? tunIx : v2
pal(p, v3 - (offRoad < beam)*beamShift)
