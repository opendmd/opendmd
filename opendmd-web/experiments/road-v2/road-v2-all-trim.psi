-- author: OpenDMD
-- licence: CC0-1.0
name "Endless road V2 (all, trimmed sketch)"
about "Desert, megacity, tunnel, forest: the whole cycle in one rough sketch"
loop forever
fps 50

-- The all sketch with fewer values (no hills, headlights, stars or lamp
-- posts; the car a box; one pick), so it compiles on a scratch build of
-- the compiler with a 512-step cap (287 steps: the real one refuses it):
-- 128 values, 50 pixel steps, ~10.0 ms VM / ~5.7 ms JIT. The sheet in
-- docs/research/endless-road-v2/cycle-sketch.png is its frames, and the
-- two transition close-ups beside it. The road eases straight and flat
-- for the tunnel's mouth and exit (owner's note), and every row reads the
-- road's bend at its depth, the sky rows mirrored about the horizon.
-- A ROUGH SKETCH for docs/research/endless-road-v2.md: every environment
-- and every transition in one program, drawn crudely, to see where four
-- environments land against the step and value caps and the frame
-- estimate. Not art. See the design doc for what each part should be.

-- One palette for the sketch (the real one wants day/night sets per
-- environment: see the doc's palette-tween proposal)
palette p = black #000, road #403, roadStripe #806, yellow #ec0, red #f00,
  verge #400, vergeStripe #800, neon #1ef, pink #f29, sun #f70, sunLow #f20,
  body #b00, lights #f50, star #fff, nightVerge #001, nightRoad #103,
  #126, #17f, #25f, #42f, #50f, #70e, #a0e, #d0d, horizon #f48,
  tower #1a0a2e, window #90e8ff, magenta #f0f, wall #443, lamp #ffb,
  canopy #052, trunk #531


-- ---- The clock of the cycle: 324 s, from somewhere else each play ----
-- Desert 0-75, into the city 75-105, city 105-180, the tunnel's mouth
-- 180-188, tunnel 188-213, out of it 213-219, forest 219-294, thinning
-- 294-324. (The doc jitters the boundaries per cycle by a hash.)
tc = (t + seed*324) % 324
pDC = smoothstep(75, 105, tc)
pCT = smoothstep(180, 188, tc)
pTF = smoothstep(213, 219, tc)
pFD = smoothstep(294, 324, tc)
inTunnel = tc >= 188 and tc < 213
mouth = (tc >= 180 and tc < 188) or (tc >= 213 and tc < 219)
exiting = tc >= 213
mouthP = exiting ? pTF : pCT
-- the road eases to straight and flat for the mouth and the exit (8 s
-- before each), and bends again 8 s after; the tunnel itself is straight
straight = smoothstep(172, 180, tc) * (1 - smoothstep(221, 229, tc))
bendAmp = 2000 - straight*2000
hillAmp = 26667 - straight*26667
city = pDC*(tc < 188)                    -- how much city: towers grow with it
forest = pTF*(1 - pFD)*(tc >= 213)       -- how dense the forest is
desert = (tc < 105)*(1 - pDC) + (tc >= 294)*pFD

-- ---- The road (V1's) ----
driven = t*.15 + seed*1000
heading = noise(driven, 0, 0)
height = noise(driven, 5, 0)
skyMid = 94 - heading*60

-- ---- Day and night (V1's), a day of 4 minutes against a cycle of 324 s ----
sunPhase = sin(t/240 + seed*3)
light = clamp(sunPhase*sunPhase*sunPhase*-3, -1, 1)
night = clamp(-light, 0, 1)
sunY = 23.5 - clamp(light*-24, -2.5, 20)
sunRow = 31 - sunY
skyStep = .5 - night/3
skyBase = 24.3 - 7*night - skyStep*-19
neon = night > .5
palmInk = forest > 0 ? p.trunk : neon*p.pink
roadInk = neon ? p.nightRoad : p.road
kerbInk = neon ? p.neon : p.yellow
vergeInk = neon ? p.nightVerge : p.verge

-- ---- The city's towers (Neon city's, scaled by `city`) ----
nearShift = heading*-90
towerGrow = city*13

-- ---- The tunnel's mouth (a box growing from the horizon) ----
mouthBase = 19.5 - mouthP*mouthP*19.5       -- the road row its foot is on
mouthW = (50.7 - 2.6*mouthBase)*1.6          -- the road's width there, and a bit
mouthTop = 19.5 + (19.5 - mouthBase)*1.1     -- its ceiling over the horizon

draw {
  -- The hills (desert only)
  -- The sun (not in the tunnel, not through the forest's canopy)
  -- the sun: a box of lines (the real one is V1's circle)
  for k < 6 {
    rowY = sunRow + k - 3
    line(skyMid - 5, rowY, skyMid + 5, rowY, (rowY <= 11.5 and not inTunnel)*5/16)
  }
  -- Roadside objects: palms in the desert, trunks in the forest, lamp
  -- posts in the city; 6 places (3 a side), one every 14 stripes
  for k < 6 {
    place = t/1.4 - k*-.37
    along = frac(place)
    ahead = 14.7 - along*14
    size = 1.2/ahead
    baseY = 11.5 + 12.5*size
    sideX = cos(k/2)*size
    objX = 64 - (heading - noise(driven + ahead*.0075, 0, 0))*2000 - sideX*-47
    there = noise(place - along, k, 0)
    palm = desert > .3 and there > .45 and ahead < 11
    trunk = forest > 0 and there > 1 - forest and ahead < 11
    line(objX, baseY, objX, baseY - 30*size, (palm or trunk)*7/16)
    dot(objX, baseY - 30*size, palm*7/16)
  }
  -- The city's neon: a lit edge on every other near tower
  for k < 17 {
    id = floor(nearShift/8) + k
    left = floor(id*8 + .9999 - nearShift)
    top = floor(hash(id%22, seed)*towerGrow + 19.9999)
    line(left + 6, 31 - (top), left + 6, 31 - (top > 31 ? 20 : top), (k%2 and city > .5)*13/16)
  }
  -- The car: a box (V1's spans are left out of this sketch for values)
  for k < 5 {
    line(52, 31 - k, 76, 31 - k, 8/16)
  }
}

-- ---- Rows ----
yu = 31 - py
below = yu < 19
tunRow = below ? yu : 39 - yu                -- the sky mirrors the road's depth
depth = .1125 / (19.5 - tunRow)
rowDriven = driven + depth
halfWidth = below*(50.7 - 2.6*(yu - clamp((noise(rowDriven, 5, 0) - height) * depth * hillAmp, -6, 2)))
stripe = (frac(39/max(halfWidth, 1.3) + t*10) < .5) * -p.step
offRoad = abs(px - (64 - (heading - noise(rowDriven, 0, 0))*bendAmp))
sky = floor(skyBase - yu*skyStep) * p.step
-- the city: towers above the horizon (the column run), lit windows
windowRow = (yu - 20)/2 + yu%2*20
nearAt = px + nearShift
nearHeight = hash(floor(nearAt/8)%22, seed)*towerGrow
nearTop = 19 + nearHeight
windows = bit(42, nearAt%8)*floor(hash(floor(nearAt), seed)*127)
towers = (not below)*((yu < nearTop)*2 + bit(windows, windowRow))
-- the tunnel: walls either side of the road, a ceiling over it, lamps
tunHalf = (50.7 - 2.6*tunRow)*1.5
inMouthRow = mouth * (yu > mouthBase) * (yu < mouthTop)
tunnelHere = inTunnel + inMouthRow*((offRoad < mouthW) != exiting)
wall = offRoad > tunHalf
lampRow = (not below) * (stripe < 0) * p.lamp
tunPix = (tunnelHere > 0) * (wall or not below)
tunIx = wall ? p.wall - stripe : (offRoad < 2) * lampRow
-- the forest: a canopy with a sliver of sky over the road
sliver = (yu - 19.5)*2.5/max(forest, .01)
canopy = forest > 0 and not below and offRoad > sliver
-- what each pixel shows
m = max((offRoad >= halfWidth) + (offRoad >= halfWidth*1.2), ink(16))
base = pick(m,
    roadInk - stripe, kerbInk - stripe, below ? vergeInk - stripe : sky,
    sky, p.star, yu - sunY < 3.5 ? p.sun : p.yellow,
    p.black, palmInk, p.body)
v1 = (m == 2 and towers > 0) ? (towers > 2 ? p.window : p.tower) : base
v2 = canopy ? p.canopy : v1
v3 = tunPix ? tunIx : v2
pal(p, v3)
