-- author: OpenDMD
-- licence: CC0-1.0
name "Rotozoom floor"
about "Mode 7 as a floor running away to a foggy horizon"
control wobble = gentle, strong, off "Wobble"
loop 9.6
smooth
-- Rotozoom floor: Mode 7 as a floor. A checker running away to a horizon
-- at the top, turning once a loop and gliding, each row scaled by its
-- distance and the far rows fogged; rows and columns wobble.
sn = sin(phase)
cs = cos(phase) -- the turn
zoom = 2        -- try 1 to 4
cu = t/0.6
cv = t/1.2                      -- the glide, in cells
amp = pick(wobble, 3, 4.5, 0)/8 -- the wobble, in texels
dx = px - 64
-- a row's distance: checker cells a pixel, smaller further down
rs = 1 / ((py + 2) * zoom)
wob = sin(py/32 + t/3.2) * amp
col = sin(px*0.0234375 - t/4.8) * amp
-- ahead by the row's distance, across by the pixel's
u = cs*rs*dx + (cu + wob + sn*rs*64)
v = sn*rs*dx + col + (cv - cs*rs*64)
cell = (floor(u) + floor(v)) % 2
-- the far rows fade into the fog (black at the horizon)
fog = py < 3 ? 0 : py < 6 ? 0.375 : py < 10 ? 0.625 : 1
pal(fire, cell ? 0.78 : 0.28) * fog
