-- licence: CC0-1.0
name "Corner clock"
about "The hour and minute as bars in a corner, over the GIF"
look
-- top bar: the hour (of 12); bottom bar: the minute
hr = 104 + (hour%12 + minute/60)/12*22
mn = 104 + minute/60*22
top = py > 25 and py < 28
bot = py > 28 and py < 31
bar = (top or bot) * (px >= 104) * (px < (top ? hr : mn))
layer multiply {
  gray(1 - (px >= 101)*(py > 23)*0.8)
}
layer {
  rgb(#ffbf4d, bar)
}
