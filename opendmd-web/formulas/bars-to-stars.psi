name "Bars to stars"
about "Two scenes in one: copper bars fading into a starfield and back"
loop 16
-- one copper bar, `lag` turns behind the first
fn bar(lag) = floor(max(0, 1 - abs(-cy - 0.35*sin(t/4 - lag))*5) * 6) / 6
fn bars() {
  red = bar(0)
  gold = bar(0.12)
  blue = bar(0.24)
  rgb(max(red, gold), max(gold*0.8, blue*0.6), blue)
}
fn stars() {
  r = frac(sin(py*0.123)*71.3)
  speed = floor(r*4)
  p = frac(x*2 + t*speed/4 + r*5)
  #fff * (max(0, 1 - p*(14 - speed*3)) * speed / 3)
}
-- 0 to 1 and back over the loop, resting at each end
k = smoothstep(0.25, 0.75, sin(phase)*0.5 + 0.5)
mix(bars(), stars(), k)
