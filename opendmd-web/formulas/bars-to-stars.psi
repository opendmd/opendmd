-- author: OpenDMD
-- licence: CC0-1.0
name "Bars to stars"
about "Two formulas in one: copper bars fading into a starfield and back"
loop 16
part bars {
  -- Copper bars
  loop 4
  red = floor(max(0, 1 - abs(cy - 0.35*sin(t/4))*5) * 6) / 6
  gold = floor(max(0, 1 - abs(cy - 0.35*sin(t/4 - 0.12))*5) * 6) / 6
  blue = floor(max(0, 1 - abs(cy - 0.35*sin(t/4 - 0.24))*5) * 6) / 6
  rgb(max(red, gold), max(gold*0.8, blue*0.6), blue)
}
part stars {
  -- Starfield
  loop 8
  r = frac(sin(py*0.123)*71.3)
  speed = floor(r*4)
  p = frac(x*2 + t*speed/4 + r*5)
  gray(max(0, 1 - p*(14 - speed*3)) * speed / 3)
}
-- 0 to 1 and back over the loop, resting at each end
k = smoothstep(0.25, 0.75, sin(t/16)*0.5 + 0.5)
layer {
  bars
}
layer {
  stars(x, y, k)
}
