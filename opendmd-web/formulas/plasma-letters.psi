name "Plasma letters"
about "Plasma fills the bright parts of the GIF: try it on text"
look
loop 8
wave = sin(x*2 + phase) + sin((1 - y)*1.5 - t/4) + sin(x*1.5 + (1 - y) + phase)
-- as bright as the GIF is there: dark stays dark
layer {
  hsv(wave/6 + phase, 0.8, ul*1.2)
}
layer add {
  gray(ul, 0.2)
}
