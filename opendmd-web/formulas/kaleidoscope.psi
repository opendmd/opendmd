name "Kaleidoscope"
about "Plasma folded into a mirror pattern: a function drawn at other places"
loop 8
fn plasma(x, y) {
  wave = sin(x*2 + phase) + sin(y*1.5 - t/4) + sin(x*1.5 + y + phase)
  hsv(wave/6 + phase, 0.9, 1)
}
-- folded twice: the same quarter in every corner, mirrored
plasma(abs(x - 0.5) * 2, abs(y - 0.5) * 2)
