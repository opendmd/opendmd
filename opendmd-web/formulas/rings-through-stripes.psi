-- author: OpenDMD
-- licence: CC0-1.0
name "Rings through stripes"
about "Two formulas in one: the stripes decide where the rings show"
control width = 0.3 "Stripe width" -- the stripes part reads it as a
loop 4
part rings {
  -- Rings
  loop 4
  pal(rainbow, frac(r*1.5 - t/2))
}
part stripes {
  -- Stripes
  loop 4
  size = 8 + a*24
  band = sin((px + (31 - py))/size - t/2)
  s = clamp(band*1.5 + 0.5, 0, 1)
  rgb(1, s, s)
}
-- the rings show only where the stripes are white
layer {
  gray(0.08)
}
layer {
  rings(x, (1 - y), stripes.s)
}
