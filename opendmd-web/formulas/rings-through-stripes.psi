name "Rings through stripes"
about "Two patterns in one: the stripes decide where the rings show"
control width = 0.3 "Stripe width"
loop 4
-- how white the diagonal stripes are here: 0 to 1
fn stripes(w) {
  size = 8 + w*24
  band = sin((px + 31 - py)/size - t/2)
  clamp(band*1.5 + 0.5, 0, 1)
}
layer {
  gray(0.08)
}
-- the rings show only where the stripes are white
layer {
  pal(rainbow, frac(r*1.5 - t/2), stripes(width))
}
