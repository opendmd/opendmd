name "Lava lamp"
about "Slow glowing blobs drifting up and down"
loop 8
blob1 = sin(x*3 + sin(phase)*0.5) * sin((1 - y)*0.8 - phase)
blob2 = sin(x*5 - phase) * sin((1 - y)*1.1 + t/4 + x)
goo = clamp((blob1 + blob2)*3 - 0.6, 0, 1)
-- purple wax glowing orange
mix(#400d59, #ff801a, goo)
