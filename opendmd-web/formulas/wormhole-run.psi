-- author: OpenDMD
-- licence: CC0-1.0
name "Wormhole run"
about "A ring ship tours the solar system, Earth to Neptune, each planet swelling from a dot, a wormhole between"
loop forever
fps 100

-- Wormhole run: a ring ship seen from behind, twelve modules turning
-- round its hub, tours the planets: Earth and the Moon, Mars, Jupiter,
-- Saturn, Neptune. Each starts as a dot and swells as we close in, the
-- big ones sooner and further, until Jupiter's bands fill half the sky;
-- then a wormhole opens ahead, a sphere showing the next sky, and we
-- dive through its rushing rings to the next planet. Each play starts
-- somewhere else on the tour.

-- Colours of what is drawn, each drawn as its place in the palette
-- (n/30) so the later win where things cross: 1-3 stars (behind
-- everything); the planets, each shade ramp dark to lit: 4-6 the
-- Earth's ocean, 7 its land, 8-10 Mars, 11-13 Neptune, 14-16
-- Jupiter's belts, 17-19 its zones (17 also Saturn's rings behind it),
-- 20 its spot, 21-23 Saturn, 24-25 its rings and the Moon; then the
-- ship: 26-28 truss and modules (the polar ice's greys too), 29 spare,
-- 30 the hub's engine glow
palette space = #000, #203050, #5070a0, #c0e0ff,
  #081c50, #1240a0, #2c70e0, #6a8040,
  #501808, #a03c18, #e07040, #102070, #2850c8, #60a0ff,
  #4a2814, #8a5434, #c08a5c, #6a5440, #c0a078, #f4e2c0, #e06030,
  #5a4628, #b09060, #ecd8a0, #a09c90, #e4e0d4,
  #4c5668, #707a8a, #c8d0dc, #fff, #60b0ff

-- The planets, Earth to Neptune: 1 over its radius at the closest
-- (px: Jupiter 62, Saturn 32, Neptune 22, Earth 15, Mars 9, the Moon a
-- quarter of the Earth: their sizes, squeezed), where it passes
-- (across, in its radii), its sky's hue (the Earth's again after
-- Neptune); its colours: the lit end of its ramp, the other ramp its
-- bands take; its feature (land, dark plains, the Great Red Spot, the
-- Great Dark Spot): how far up, how tall, its colour
table closest = .0667, .1111, .0161, .0313, .0455
table passX = 1.6, -1.9, .9, -1.25, -1.4
table sky = .62, .97, .08, .78, .5, .62
table lit = .2, .3333, .6333, .7667, .4333
table belt = 0, 0, -.1, -.1333, 0
table featY = .15, .1, -.32, 0, .3
table featH = .4, .5, .13, 0, .12
table featInk = .2333, .2667, .6667, 0, .3667

frame {
  -- Where we are on the tour: legs of 20 s, which planet
  tour = t/20 + seed*100
  f = frac(tour)
  planet = floor(tour)%5

  -- The planet swells from a dot as we close in (the big ones show
  -- sooner), slowing at the closest, further out as it grows; gone in
  -- the wormhole
  away = 1 - min(f*1.3, 1)
  R = (f < .9) / (away*away*1.5 + closest[planet])
  pX = passX[planet]*R + 64
  pY = R*.25 + 16

  -- Saturn's rings, or by the Earth the Moon: the middle, the squared
  -- heights outside and in, how wide, below which row from the middle
  -- they are in front
  earth = planet == 0
  ringX = pX - earth*R*2.4
  ringY = pY + earth*R*.7
  outside = R * R * ((planet == 3)*.3 + earth*.07)
  inside = earth ? 0 : outside*.3
  wide = earth ? 1 : 4.2
  cut = earth*99

  -- The wormhole, from .75 of a leg (g from 0): a sphere opening ahead
  -- with the next sky in it, all round us from .9 to .04 (the stars in
  -- rings there), then the new sky opening out from the middle
  g = frac(f + .25)
  wR = (g < .4) * g * g * g * 25000
  hR = max(g - .25, 0) * 1500
  tunnel = abs(g - .22) < .07
  grain = tunnel ? 4 : 999
  warp = max(f - .7, 0)
  skyIn = sky[planet + (g < .25)]

  -- The ship sways and bobs
  shipX = sin(f)*14 + 63
  shipY = sin(f*4)*1.5 + 9
}

draw {
  -- Stars: 40 flying at us and streaking past, faster and longer into
  -- the wormhole, where they fly in rings; hidden once off the panel
  -- (and behind the planet, drawn brighter)
  for k < 40 {
    starX = hash(k, 7) - .5
    starY = hash(k, 3)*.25 - .125
    near = frac(f*6 + warp*warp*33.334 - floor(hash(k, 11)*grain)/grain)
    ring = tunnel*6*(abs(starX) + abs(starY*4)) + 1 - tunnel
    head = 64 / (1.0156 - near) / ring
    tail = 64 / (warp + 1.07 - near) / ring
    hx = starX*head
    hy = starY*head
    row = abs(hx) > 64 or abs(hy) > 16 ? -999 : 16
    line(starX*tail + 64, starY*tail + row, hx + 64, hy + row, 0, near*.1)
  }

  -- The planet, a line a row of the panel lit from the left (bands,
  -- polar ice), its feature over it, centred at a wandering longitude
  -- and widest at its middle; the rings, in front below the middle and
  -- behind above, or the Moon
  for k < 32 {
    dy = k - pY
    half = sqrt(R*R - dy*dy)
    y0 = half > 0 ? k : -999
    ny = dy/R
    shade = abs(ny) > .82 + (planet > 1)*2 ? .9333 : (noise(ny*9, 3, 0) > .5)*belt[planet] + lit[planet]
    line(pX - half, y0, pX + half, y0, shade, shade - .0667)
    reach = featH[planet] - abs(ny - featY[planet])
    mid = (noise(ny*4, 5, 0) - .5)*featH[planet]*3*half + pX
    across = sqrt(reach*featH[planet])*R*.8
    y1 = reach > 0 ? y0 : -999
    line(mid - across, y1, mid + across, y1, featInk[planet])
    dy = k - ringY
    outer = sqrt(outside - dy*dy) * wide
    inner = sqrt(inside - dy*dy) * wide
    y2 = outer > 0 ? k : -999
    edge = dy < cut ? .8 : .5667
    line(ringX - outer, y2, ringX - inner, y2, edge, edge + .0333)
    line(ringX + outer, y2, ringX + inner, y2, edge, edge + .0333)
  }

  -- The ship from behind: twelve boxy modules turning on a ring round
  -- the hub, the truss between them, the far side darker; its engine
  for k < 12 {
    co = cos(k/12 + f/6)
    si = sin(k/12 + f/6)
    mx = co*10 + shipX
    my = si*5.5 + shipY
    line(mx, my, mx - si*5.2, my + co*2.9, .8667)
    line(mx, my, mx + 1, my, .9167 - si*.03)
    line(mx, my + 1, mx + 1, my + 1, .9167 - si*.03)
  }
  dot(shipX, shipY, 1)
}

-- The sky, redrawn every fourteenth frame: this leg's haze; the
-- wormhole's sphere, the next sky swirling in it, its rim bright
layer rate 14 {
  dx = px - 63.5
  d2 = dx*dx + (py - 15.5)*(py - 15.5)
  inW = d2 < wR*wR and d2 > hR*hR
  cloud = noise(px*.05, py*.1, 0)
  hsv(inW ? skyIn + cloud*.1 : sky[planet], .8, cloud*(inW ? .45 : cloud*.4) + inW*(d2 > wR*wR*.6)*.6)
}
layer max {
  pal(space, ink)
}
