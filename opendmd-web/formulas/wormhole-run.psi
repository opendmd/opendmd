-- author: OpenDMD
-- licence: CC0-1.0
name "Wormhole run"
about "A little ship flies through space past stars and planets, and into a wormhole to somewhere new"
loop forever
fps 100

-- Wormhole run: a ship seen from behind, cruising through a nebula with
-- the stars streaming past and now and then a planet (some with rings)
-- drifting by. Every 24 seconds a wormhole opens ahead: the stars
-- stretch, rings rush at us, and we come out somewhere else, under
-- another colour of sky. Each play starts in another place and time.

-- Colours of what is drawn, each drawn as its place in the palette so
-- the later win where things cross: star streaks (dim to bright), two
-- planets (lit side last), a planet's ring, the wormhole's rings (far
-- to near), then the ship
palette space = black #000, #203050, #5070a0, #a0c0ff, #fff, #301008,
  #702818, #b04820, #e07830, #ffb860, #081830, #104060, #2080a0,
  #40c0d0, #a0f0f0, ring #c0a080, tunnel #301060, #8020c0, #e040ff,
  #ffd0ff, hullDark #384050, hull #8090a0, hullLight #d0d8e0, glass #30a0ff,
  red #ff3030, engine #ff9020, flame #ffffa0

-- The ship from behind: 14 spans (its flames the last two), each `from + (to + (row + colour)/16)/64`
-- with colour its place in the palette
table ship = 8.13266, 7.147308, 6.161926, 7.146378, 3.207825,
  0.253677, 2.221497, 0.018478, 15.252853, 4.189224,
  5.095673, 10.173798, 5.094711, 10.172836

frame {
  -- Where we are in this stretch of space (0 to 1 over 24 s) and which
  -- stretch it is; the wormhole: opening from .78, through it until we
  -- come out at .06 of the next; its pull on the stars
  leg = t/24 + seed*100
  place = hash(floor(leg), 5)
  leg = frac(leg)
  tunnel = clamp((leg - .78) * 12, 0, 1)*clamp((1.06 - leg) * 12, 0, 1) + clamp((.06 - leg) * 12, 0, 1)
  rush = clamp((leg - .7) * 6, 0, 1)
  travel = frac(t*.35 + rush*rush*3)

  -- The ship sways and bobs, and shakes in the wormhole
  shipX = 56 + sin(frac(t*.07))*20 + tunnel*(hash(floor(t*30), 1) - .5)*2
  shipY = 3.5 + sin(frac(t*.23))*1.5

  -- The wormhole's rings come round every 0.83 s, swinging and turning;
  -- the clouds drift
  rings = frac(t*1.2)
  swing = frac(t*.1)
  drift = frac(t/500)*10

  -- This stretch's planet: where it drifts (in from the right over the
  -- first part of the stretch), how big, which colours, a ring or not
  planetX = 150 - leg*160
  planetY = 18 + place*10
  planetR = 4 + place*5
  planetLit = (frac(place*7) > .5)*5*space.step + space.step*9
  ringOn = frac(place*13) > .45
}

draw {
  -- Stars: 64, flying at us from far off and streaking past; longer as
  -- the wormhole pulls
  for k < 64 {
    starX = hash(k, 7)*64 - 32
    starY = hash(k, 3)*16 - 8
    near = frac(travel - hash(k, 11))
    head = 1 / (65/64 - near)
    tail = 1 / (65/64 + .04 + rush*.25 - near)
    row = abs(starX*head) > 64 or abs(starY*head) > 16 ? -999 : 16
    lit = (near*near*3 + 1) * (1 - tunnel*.6) * space.step
    line(64 + starX*tail, row + starY*tail, 64 + starX*head, row + starY*head, lit*.3, lit)
  }

  -- The planet, a line a row, lit from the left, and its ring in front
  for k < 19 {
    e = k - 9
    halfRow = sqrt(planetR*planetR - e*e)
    shown = (halfRow > 0) * (tunnel < .5)
    line(planetX - halfRow, planetY + e, planetX + halfRow, planetY + e, planetLit*shown, (planetLit - space.step*4) * shown)
  }
  for k < 12 {
    a0 = k/12
    ringX = cos(a0)*planetR*1.9
    ringY = sin(a0)*planetR*.35
    front = ringY < 0 or abs(ringX) > planetR
    line(planetX + ringX, planetY + ringY, planetX + cos(a0 + 1/12)*planetR*1.9, planetY + sin(a0 + 1/12)*planetR*.35, front * ringOn * (tunnel < .5) * space.ring)
  }

  -- The wormhole: its far end glowing, and five rings rushing at us,
  -- swinging as it bends
  for k < 5 {
    glow = sqrt(6.5 - (k - 2)*(k - 2)) * 1.5 * tunnel
    line(64 + sin(swing*4)*14 - glow, 14 + k + sin(swing*3)*4, 64 + sin(swing*4)*14 + glow, 14 + k + sin(swing*3)*4, (tunnel > 0) * (space.tunnel + space.step*3))
  }
  for k < 5 {
    near = frac(rings + k/5)
    size = 2 / (1.04 - near)
    midX = 64 + sin(swing*4 + near*.06)*14
    midY = 16 + sin(swing*3 + near*.06)*4
    lit = (tunnel > 0) * (space.tunnel + near*tunnel*3*space.step)
    for j < 8 {
      line(midX + cos(j/8 + swing)*size*2, midY + sin(j/8 + swing)*size, midX + cos(j/8 + .125 + swing)*size*2, midY + sin(j/8 + .125 + swing)*size, lit)
    }
  }

  -- The ship, span by span
  for k < 14 {
    span = frac(ship[k])*64
    rowInk = frac(span)*16
    line(shipX + floor(ship[k]), shipY + floor(rowInk), shipX + floor(span), shipY + floor(rowInk), frac(rowInk))
  }
}

-- The nebula, redrawn every eighth frame: soft clouds drifting, in this
-- stretch's colour, dimming in the wormhole; the drawn things over it
layer rate 8 {
  cloud = noise(px*.05 + drift, py*.1, 0)
  hsv(place + cloud*.2, .8, cloud * cloud * (.55 - tunnel*.4))
}
layer max {
  pal(space, ink)
}
