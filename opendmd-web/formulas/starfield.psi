-- author: OpenDMD
-- licence: CC0-1.0
-- bundle
name "Starfield"
about "192 stars streaking at you: lines drawn once a frame"
control streak = 0 "Streak length"
loop 2.4
smooth
-- Starfield: 192 stars flying at you, a pass through the field a loop,
-- each a streak from where it was a moment ago
back = 1 + 1/64 + (144 + streak*240)/4096
draw {
  for k < 192 {
    sx = hash(k, 7)*32 - 16
    sy = hash(k, 3)*8 - 4            -- where it is, across and up
    near = frac(phase - hash(k, 11)) -- 0 far, 1 at you
    s = 1 / (65/64 - near)
    st = 1 / (back - near) -- perspective, now and a moment ago
    hx = sx*s
    hy = sy*s -- the head, from the middle
    -- the middle row; a head off the panel: the line moved far below it,
    -- where it is skipped
    row = abs(hx) > 64 or abs(hy) > 16 ? 1030 : 15
    lit = near*near -- squared: far stars stay dark longer
    line(64 + sx*st, row - sy*st, 64 + hx, row - hy, lit*0.2, lit)
  }
}
pal(ice, ink)
