-- bundle
name "Old TV"
about "Scanlines, a rolling band and dark corners over the GIF"
look
loop 4
dx = (x - 0.5) * 1.6
dy = (0.5 - y) * 1.2
lines = py%2 ? 0.6 : 1
roll = 0.85 + 0.15*max(0, tri((1 - y)/2 + phase))
corners = clamp(1.5 - (dx*dx + dy*dy)*1.6, 0, 1)
layer multiply {
  gray(lines*roll*corners)
}
