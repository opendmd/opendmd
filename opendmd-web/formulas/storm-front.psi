-- licence: CC0-1.0
name "Storm front"
about "Heavy clouds rolling over, drawn a band at a time, under rain that falls every frame"
loop forever
-- the clouds: slow, so redrawn every 4th frame, a quarter of the rows each time
layer rate 4 {
  cl = noise(x*3 - t*0.15, (1 - y)*2, 0)*0.7 + noise(x*7 - t*0.3, (1 - y)*5, 0)*0.3
  pal(ice, cl*0.8 + (1 - y)*0.3) * (0.35 + cl*0.5)
}
-- the rain: thin streaks, falling every frame
layer add {
  fall = frac(t/8)*96
  d = hash(px, floor(py/4 + hash(px, 1)*8 - fall))
  gray(d > 0.93 ? 0.45 : 0)
}
