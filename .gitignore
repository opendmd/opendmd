target
**/target
.embuild
sdkconfig

# Never commit the DMDoS GIF pack or a card dump — third-party content, not
# ours to redistribute. Test fixtures are generated in code, not checked in.
card/
cards/
gifs/
**/gifs/
*.gif
*.odm
filelist.txt
filelist.hall
filelist.xmas
filelist.odm.txt

# hardware/ is deliberately NOT ignored: the measured pinout and photos are
# the one thing that can't be regenerated.

# wasm-pack output and `make web`'s precompressed copies
opendmd-web/www/pkg/
opendmd-web/www/pkg-art/
opendmd-web/www/pkg-psi/
opendmd-web/www/pkg-psi-lang/
opendmd-web/www/pkg-studio/
opendmd-web/www/**/*.gz
opendmd-web/www/version.txt
opendmd-web/www/js/build.js
opendmd-web/www/licenses.txt
# Written by make web from opendmd-web/formulas/*.psi (the -- bundle ones: tools/formulas-json.py).
opendmd-web/www/formulas.json
opendmd-web/www.pack
# make web's output (tools/web-minify.py): www/ with its scripts and stylesheets minified, and the .gz copies
opendmd-web/www-dist/

# Release images (make fw-release)
dist/
__pycache__/

# Firmware signing keys: only the public half is committed (firmware/keys/opendmd.pub).
*.key
*.pem

# Secrets anywhere in the tree: .env files (firmware/.env's bench WiFi and
# any other), wrangler's local secrets (site/worker/.dev.vars). The examples
# (names, no values) stay committed.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Experiment outputs made from third-party art (DMDoS pack GIFs, homebrew
# ROMs, console logos): regenerate locally, never commit (CLAUDE.md "Content
# licensing"). The Kenney (CC0) inputs and PNG outputs in art/process stay committed.
opendmd-web/experiments/tween/out/sheets/
opendmd-web/experiments/art/emulator/out/*.png
opendmd-web/experiments/art/process/out/c_logos.png
opendmd-web/experiments/art/process/out/e_title_cards.png
opendmd-web/experiments/art/process/out/f_emulator_title.png
opendmd-web/experiments/art/studio/out/commons_saturn_logo.png
opendmd-web/experiments/art/studio/out/paste_snes_logo.png
opendmd-web/experiments/art/studio/out/studio_page.png

# The tweening experiment's outputs: contact sheets, tables and lists of the
# DMDoS pack's files (derived from third-party content): generated, never committed
opendmd-web/experiments/tween/out/
# The CORS probe's raw capture (a local output: the hosts one browser run met)
opendmd-web/experiments/art/cors/cors_results.json

# This machine's own settings: local.mk (read by the Makefile: SCRATCH,
# CARD_ROOT, ...) and CLAUDE.local.md (notes Claude Code reads beside CLAUDE.md)
/local.mk
CLAUDE.local.md
