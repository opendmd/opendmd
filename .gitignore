target
**/target
.embuild
sdkconfig

# Never commit the DMDoS GIF pack or a card dump — third-party content, not
# ours to redistribute. Test fixtures are generated in code, not checked in.
card/
cards/
gifs/
**/gifs/
*.gif
*.odm
filelist.txt
filelist.hall
filelist.xmas
filelist.odm.txt

# hardware/ is deliberately NOT ignored: the measured pinout and photos are
# the one thing that can't be regenerated.

# wasm-pack output and `make web`'s precompressed copies
opendmd-web/www/pkg/
opendmd-web/www/pkg-art/
opendmd-web/www/pkg-psi/
opendmd-web/www/**/*.gz
opendmd-web/www/version.txt
opendmd-web/www/licenses.txt
opendmd-web/www.pack

# Release images (make fw-release)
dist/
__pycache__/

# Firmware signing keys: only the public half is committed (firmware/keys/opendmd.pub).
*.key

# Experiment outputs made from third-party art (DMDoS pack GIFs, homebrew
# ROMs, console logos): regenerate locally, never commit (CLAUDE.md "Content
# licensing"). The Kenney (CC0) outputs in art/process/out stay committed.
opendmd-web/experiments/tween/out/sheets/
opendmd-web/experiments/art/emulator/out/*.png
opendmd-web/experiments/art/process/out/c_logos.png
opendmd-web/experiments/art/process/out/e_title_cards.png
opendmd-web/experiments/art/process/out/f_emulator_title.png
opendmd-web/experiments/art/studio/out/commons_saturn_logo.png
opendmd-web/experiments/art/studio/out/paste_snes_logo.png
opendmd-web/experiments/art/studio/out/studio_page.png

# Lists of the DMDoS pack's files (derived from third-party content): generated, never committed
opendmd-web/experiments/tween/out/candidates.json
opendmd-web/experiments/tween/out/summary.json
opendmd-web/experiments/tween/out/files.jsonl
