target
**/target
.embuild
sdkconfig

# Never commit the DMDoS GIF pack or a card dump — third-party content, not
# ours to redistribute. Test fixtures are generated in code, not checked in.
card/
cards/
gifs/
**/gifs/
*.gif
*.odm
filelist.txt
filelist.hall
filelist.xmas
filelist.odm.txt

# hardware/ is deliberately NOT ignored: the measured pinout and photos are
# the one thing that can't be regenerated.

# wasm-pack output and `make web`'s precompressed copies
opendmd-web/www/pkg/
opendmd-web/www/pkg-art/
opendmd-web/www/**/*.gz
opendmd-web/www/version.txt
opendmd-web/www/api.html
opendmd-web/www.pack

# Release images (make fw-release)
dist/
__pycache__/

# Firmware signing keys: only the public half is committed (firmware/keys/opendmd.pub).
*.key
